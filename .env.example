# --------------------- Server Settings ----------------------
PORT=3002
HOST=127.0.0.1
NODE_ENV=production
SHUTDOWN_TIMEOUT_MS=10000

# ------------------- Application Settings -------------------
APP_PUBLIC_BASE_URL=https://armory.darkavianlabs.com
# Comma-separated origins allowed for Clerk session azp validation (Armory + sibling apps).
# These are full trust peers that share Clerk sessions and the domain-wide session cookie.
ALLOWED_APP_ORIGINS=https://codex.darkavianlabs.com,https://armory.darkavianlabs.com

# ------------------- Session Settings -----------------------
# Used for CSRF tokens only — not for login (Clerk handles auth)
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars
# Dev-only: allow hardcoded SESSION_SECRET fallback when SESSION_SECRET is unset.
# Never enable outside local loopback. Required if you omit SESSION_SECRET in development.
# ALLOW_INSECURE_DEV=1
SESSION_COOKIE_NAME=darkavianlabs.armory.sid

# -------------------- Proxy Settings ------------------------
TRUST_PROXY=1
SECURE_COOKIES=1

# ------------------- Cookie Settings ------------------------
# Leading-dot domain so all apps on *.darkavianlabs.com share the session cookie.
COOKIE_DOMAIN=.darkavianlabs.com

# ------------------- Clerk Settings -------------------------
# Dashboard → API Keys. App admin: publicMetadata.apps.armory = "admin"
# Session token claim: "metadata": "{{user.public_metadata}}"
# Server-side Clerk reads CLERK_PUBLISHABLE_KEY; VITE_ is used for the client bundle.
# Optional override if your Clerk Frontend API host differs from the default.
# CLERK_FAPI_URL=https://clerk.darkavianlabs.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk Dashboard → Webhooks → signing secret (Armory endpoint: /api/webhooks/clerk)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ------------------- Databases ------------------------------
# Relative paths are fine for local dev (resolved from project root where noted).
# Production: use absolute paths for all three (see server/config.ts).
# Catalog only (DE exports, wiki merge). Codex reads ARMORY_DB_PATH read-only.
ARMORY_DB_PATH=./data/armory.db
# User builds and loadouts (separate from catalog).
USER_DB_PATH=./data/builds.db
# Express-session store (CSRF). App-local — not shared with Codex.
SESSION_DB_PATH=./data/session.db

# ------------------- Import Settings ------------------------
# Optional: used when NODE_ENV=test (Vitest). Copy values from .env.development as needed.
WIKI_USER_AGENT="DarkAvianLabs-Armory/1.0 (+https://armory.darkavianlabs.com)"

# ------------------- Vite Settings --------------------------
VITE_APP_NAME=Armory
VITE_LEGAL_ENTITY_NAME="Dark Avian Labs"
VITE_LEGAL_PAGE_URL=https://darkavianlabs.com/legal/
VITE_SHARED_THEME_COOKIE_DOMAIN=.darkavianlabs.com
