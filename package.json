{
  "name": "armory",
  "version": "1.66.1",
  "private": true,
  "description": "Armory - Warframe Mod Builder/Planner",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "validate": "node run-quality-checks.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "start": "node dist/server/index.js",
    "data:import": "node dist/server/import/runManualImport.js",
    "data:migrate-artifact-slots": "node dist/server/import/runMigrateArtifactSlots.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "check-format": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/patchCoverageLayout.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.26",
    "@clerk/react": "^6.9.1",
    "@dotenvx/dotenvx": "^1.71.3",
    "@fontsource-variable/cascadia-mono": "^5.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/material-symbols-rounded": "^5.2.45",
    "better-sqlite3": "^12.10.0",
    "better-sqlite3-session-store": "^0.1.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csrf-sync": "^4.2.1",
    "cuimp": "^2.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "html-to-image": "^1.11.13",
    "lzma": "^2.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "domhandler": "^6.0.1",
    "globals": "^17.6.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "semantic-release": "25.0.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=25.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.6.0"
}
